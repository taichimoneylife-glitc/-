[
 {
  "start": 0.0,
  "end": 4.34,
  "text": "例えば500万円の車買い方は現金一括化銀行論化 結論"
 },
 {
  "start": 4.34,
  "end": 6.02,
  "text": "僕は得てローンで買います"
 },
 {
  "start": 6.02,
  "end": 9.5,
  "text": "キーリンリパーセントで10年で組むと 車両価格は500万円"
 },
 {
  "start": 9.5,
  "end": 11.08,
  "text": "利息は多いそう50万円"
 },
 {
  "start": 11.08,
  "end": 13.42,
  "text": "送信払い額は約550万円"
 },
 {
  "start": 13.42,
  "end": 16.14,
  "text": "利息の50万円は損と思うかもしれないけど"
 },
 {
  "start": 16.14,
  "end": 18.38,
  "text": "問題はここからの元での資金の使い方"
 },
 {
  "start": 18.38,
  "end": 21.28,
  "text": "僕なら元での500万円を運用に回します"
 },
 {
  "start": 21.28,
  "end": 22.84,
  "text": "何で運用するかが重要で"
 },
 {
  "start": 22.84,
  "end": 24.32,
  "text": "株化再建なのか"
 },
 {
  "start": 24.32,
  "end": 26.32,
  "text": "僕はここではリスクを取りたくないので"
 },
 {
  "start": 26.32,
  "end": 29.02,
  "text": "安定的な運用ができる再建を選びます"
 },
 {
  "start": 29.02,
  "end": 31.56,
  "text": "コスラデスタイは特に教育資金やローゴ資金"
 },
 {
  "start": 31.56,
  "end": 34.86,
  "text": "その他特別費用の備えなどを計画的にしないといけない"
 },
 {
  "start": 34.86,
  "end": 36.46,
  "text": "株は貿易のリスクもあるけど"
 },
 {
  "start": 36.46,
  "end": 38.58,
  "text": "再建は数年後にいくらになるか"
 },
 {
  "start": 38.58,
  "end": 40.86,
  "text": "原則約束された人さんだから計画的"
 },
 {
  "start": 40.86,
  "end": 42.28,
  "text": "しかも今米国際なら"
 },
 {
  "start": 42.28,
  "end": 44.1,
  "text": "金利は約5%と高水準"
 },
 {
  "start": 44.1,
  "end": 45.62,
  "text": "では10年後どうなるのか"
 },
 {
  "start": 45.62,
  "end": 48.1,
  "text": "再建で運用すると約810万円"
 },
 {
  "start": 48.1,
  "end": 50.6,
  "text": "車の送信払い額550万円を引いても"
 },
 {
  "start": 50.6,
  "end": 52.5,
  "text": "約260万円のプラス"
 },
 {
  "start": 52.5,
  "end": 53.98,
  "text": "利息50万円を払っても"
 },
 {
  "start": 53.98,
  "end": 56.38,
  "text": "運用液260万円の方が大きい"
 },
 {
  "start": 56.38,
  "end": 57.7,
  "text": "だから長期的に見ると"
 },
 {
  "start": 57.7,
  "end": 59.12,
  "text": "トータルで解くっていうことです"
 }
]