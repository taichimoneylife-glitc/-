# Discord Bot Token (Discord Developer Portal で取得)
DISCORD_TOKEN=your_discord_bot_token_here

# ニュースを投稿するチャンネルID (チャンネルを右クリック → IDをコピー)
NEWS_CHANNEL_ID=your_channel_id_here

# ニュース配信間隔（分単位、デフォルト60分）
NEWS_INTERVAL_MINUTES=60

# 取得するニュース件数（デフォルト5件）
NEWS_COUNT=5

# ---- note記事自動化 ----

# Anthropic API Key (https://console.anthropic.com で取得)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# noteのログイン情報
NOTE_EMAIL=your_note_email_here
NOTE_PASSWORD=your_note_password_here

# 毎日の自動投稿時刻（日本時間、デフォルト10:00）
NOTE_POST_HOUR=10
NOTE_POST_MINUTE=0

# 自動で公開投稿するか（true=公開, false=下書き保存）
NOTE_AUTO_PUBLISH=false
